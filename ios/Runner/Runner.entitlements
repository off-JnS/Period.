<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!--
	The app's own group comes FIRST. Keychain items saved without an explicit
	group (the database key, via flutter_secure_storage) go to the first group
	listed; keeping the private group first means that key can never land in
	the shared group the widget reads. Only the widget snapshot is written to
	app.period.shared, explicitly.
	-->
	<key>keychain-access-groups</key>
	<array>
		<string>$(AppIdentifierPrefix)app.period</string>
		<string>$(AppIdentifierPrefix)app.period.shared</string>
	</array>
</dict>
</plist>
