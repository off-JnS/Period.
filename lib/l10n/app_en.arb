{
  "@@locale": "en",
  "appTitle": "Period.",
  "@appTitle": {
    "description": "The app name, shown in the task switcher and as the default screen title. A brand name, so it is identical in every language."
  },
  "todayTitle": "Today",
  "@todayTitle": {
    "description": "Title of the Today screen, the app's home."
  },
  "cycleDay": "Day {day}",
  "@cycleDay": {
    "description": "The current day of the cycle, shown in the middle of the ring. Kept very short because it sits inside a circle.",
    "placeholders": {
      "day": {
        "type": "int"
      }
    }
  },
  "cycleDayAccessibility": "Cycle day {day}",
  "@cycleDayAccessibility": {
    "description": "Spoken description of the cycle ring for screen readers. Says the value aloud, because the ring itself conveys nothing to a screen reader.",
    "placeholders": {
      "day": {
        "type": "int"
      }
    }
  },
  "noCycleInProgress": "No cycle yet",
  "@noCycleInProgress": {
    "description": "Shown in the middle of the ring when no period start has been logged, so there is no cycle day to count."
  },
  "nextPeriodHeading": "Next period",
  "@nextPeriodHeading": {
    "description": "Heading above the estimated next period date range."
  },
  "estimatedRange": "{from} – {to}",
  "@estimatedRange": {
    "description": "A date range. Never a single date: an estimate is always a window.",
    "placeholders": {
      "from": {
        "type": "String"
      },
      "to": {
        "type": "String"
      }
    }
  },
  "estimatedFromYourEntries": "Estimated, based on your entries",
  "@estimatedFromYourEntries": {
    "description": "Qualifier under every estimate. Required wording: an estimate must never read as a certainty."
  },
  "needMoreCycles": "Log {remaining, plural, =1{one more period} other{{remaining} more periods}} before an estimate is possible",
  "@needMoreCycles": {
    "description": "Explains why there is no estimate yet. Says what to do rather than only what is missing.",
    "placeholders": {
      "remaining": {
        "type": "int"
      }
    }
  },
  "cyclesTooVariable": "Your cycle lengths vary too much to estimate a range right now",
  "@cyclesTooVariable": {
    "description": "Shown instead of an estimate when the spread is so wide that a window would be meaningless. Describes the data, never the person."
  },
  "predictionsOffContraception": "Estimates are off while you are tracking hormonal contraception, because a withdrawal bleed follows your regimen rather than a natural cycle",
  "@predictionsOffContraception": {
    "description": "Explains why no estimate is shown in the hormonal contraception mode. Explaining beats showing nothing, which reads as a bug."
  },
  "predictionsOffPregnancy": "Estimates are off during pregnancy. Everything you log is still saved",
  "@predictionsOffPregnancy": {
    "description": "Explains why no estimate is shown during pregnancy, and reassures that logging still works."
  },
  "predictionsOffPerimenopause": "Estimates are off. Cycle lengths often change a lot during perimenopause, so an estimate can be misleading. You can turn estimates on in settings",
  "@predictionsOffPerimenopause": {
    "description": "Explains why estimates are off in perimenopause and that the user may re-enable them."
  },
  "fertileWindowHeading": "Estimated fertile window",
  "@fertileWindowHeading": {
    "description": "Heading above the fertile window estimate."
  },
  "fertileWindowCaveat": "A wide estimate based on dates alone. Dates cannot show when ovulation happens. Not suitable for preventing pregnancy",
  "@fertileWindowCaveat": {
    "description": "Required note beside the fertile window. Must always be visible, never behind a tap."
  },
  "doctorHint": "Your recent cycles have varied more than usual. This might be worth mentioning to a doctor",
  "@doctorHint": {
    "description": "Shown rarely. Describes the entries and suggests a conversation. Never names a condition and never states a finding."
  },
  "dismiss": "Dismiss",
  "@dismiss": {
    "description": "Button that hides the doctor hint."
  },
  "logToday": "Log today",
  "@logToday": {
    "description": "Button on the Today screen that opens the sheet for recording a day."
  },
  "logForDate": "Log {date}",
  "@logForDate": {
    "description": "Title of the logging sheet, naming the day being recorded.",
    "placeholders": {
      "date": {
        "type": "String"
      }
    }
  },
  "periodStartedToday": "My period started this day",
  "@periodStartedToday": {
    "description": "Switch marking a day as the first day of a period. This is the only thing the app treats as a cycle boundary, so the wording has to be unambiguous about which day."
  },
  "flowHeading": "Bleeding",
  "@flowHeading": {
    "description": "Heading above the bleeding intensity choices."
  },
  "flowNone": "None",
  "@flowNone": {
    "description": "Bleeding intensity: none recorded for this day. Distinct from not answering at all."
  },
  "flowLight": "Light",
  "@flowLight": {
    "description": "Bleeding intensity: light."
  },
  "flowMedium": "Medium",
  "@flowMedium": {
    "description": "Bleeding intensity: medium."
  },
  "flowHeavy": "Heavy",
  "@flowHeavy": {
    "description": "Bleeding intensity: heavy."
  },
  "symptomsHeading": "Symptoms",
  "@symptomsHeading": {
    "description": "Heading above the symptom chips."
  },
  "symptomCramps": "Cramps",
  "@symptomCramps": {
    "description": "Symptom label. The database stores an opaque key; this is its translation."
  },
  "symptomHeadache": "Headache",
  "@symptomHeadache": {
    "description": "Symptom label."
  },
  "symptomTiredness": "Tiredness",
  "@symptomTiredness": {
    "description": "Symptom label."
  },
  "symptomBloating": "Bloating",
  "@symptomBloating": {
    "description": "Symptom label."
  },
  "symptomMoodChange": "Mood change",
  "@symptomMoodChange": {
    "description": "Symptom label. Deliberately neutral: describes what the user noticed, never diagnoses it."
  },
  "symptomBackPain": "Back pain",
  "@symptomBackPain": {
    "description": "Symptom label."
  },
  "noteHeading": "Note",
  "@noteHeading": {
    "description": "Heading above the free-text note field."
  },
  "noteHint": "Anything you want to remember",
  "@noteHint": {
    "description": "Placeholder in the note field. Open-ended on purpose: the app never parses this text."
  },
  "save": "Save",
  "@save": {
    "description": "Confirms and stores the day's entry."
  },
  "cancel": "Cancel",
  "@cancel": {
    "description": "Closes the logging sheet without saving."
  },
  "entrySaved": "Saved",
  "@entrySaved": {
    "description": "Brief confirmation after an entry is stored."
  },
  "couldNotOpenData": "Period. could not open your data",
  "@couldNotOpenData": {
    "description": "Shown when the database fails to open. States the fact without speculating about the cause or promising the data is safe, because at this point the app does not know either."
  },
  "couldNotOpenDataDetail": "This can happen if the app was interrupted. Your entries are still on this device.",
  "@couldNotOpenDataDetail": {
    "description": "Reassurance under the error heading. Says the file is still present, which is true and is the thing a user actually fears, without claiming it can be read."
  },
  "tryAgain": "Try again",
  "@tryAgain": {
    "description": "Retries opening the data after a failure."
  },
  "undo": "Undo",
  "@undo": {
    "description": "Reverses the change just made, offered beside the save confirmation."
  },
  "laterThanUsual": "{days, plural, =1{1 day} other{{days} days}} later than your usual {typical}",
  "@laterThanUsual": {
    "description": "Shown under the ring when the current cycle has run past the user's typical length. An observation about her own entries, never a warning and never a suggestion that something is wrong.",
    "placeholders": {
      "days": {
        "type": "int"
      },
      "typical": {
        "type": "int"
      }
    }
  },
  "calendarTitle": "Calendar",
  "@calendarTitle": {
    "description": "Title of the calendar screen."
  },
  "navToday": "Today",
  "@navToday": {
    "description": "Label of the Today tab in the bottom navigation bar. Deliberately separate from todayTitle: a tab label has less room than a screen title and may need to be shortened in a language where the title cannot be."
  },
  "navCalendar": "Calendar",
  "@navCalendar": {
    "description": "Label of the Calendar tab in the bottom navigation bar."
  },
  "previousMonth": "Previous month",
  "@previousMonth": {
    "description": "Spoken label for the button that moves the calendar back one month."
  },
  "nextMonth": "Next month",
  "@nextMonth": {
    "description": "Spoken label for the button that moves the calendar forward one month."
  },
  "legendPeriodStart": "Period start",
  "@legendPeriodStart": {
    "description": "Names the filled marker in the calendar legend. Every calendar state is named in words as well as drawn, because meaning must never rest on colour alone."
  },
  "legendLogged": "Logged",
  "@legendLogged": {
    "description": "Names the dot marking a day with an entry."
  },
  "legendEstimated": "Estimated period",
  "@legendEstimated": {
    "description": "Names the outlined marker for days inside the predicted window."
  },
  "dayAccessibility": "{date}{markers}",
  "@dayAccessibility": {
    "description": "Spoken description of one calendar day: the date, then whatever is true of it. Screen readers get nothing from a coloured circle.",
    "placeholders": {
      "date": {
        "type": "String"
      },
      "markers": {
        "type": "String"
      }
    }
  },
  "nothingLoggedThisMonth": "Nothing logged this month",
  "@nothingLoggedThisMonth": {
    "description": "Shown under an empty calendar month, so a blank grid does not read as a broken screen."
  },
  "today": "Today",
  "@today": {
    "description": "Names the current day in the calendar legend and in spoken day descriptions."
  },
  "settingsTitle": "Settings",
  "@settingsTitle": {
    "description": "Title of the settings screen."
  },
  "navSettings": "Settings",
  "@navSettings": {
    "description": "Label of the Settings tab in the bottom navigation bar."
  },
  "cycleModeHeading": "Your cycle right now",
  "@cycleModeHeading": {
    "description": "Heading above the cycle mode choices. Phrased as a current situation rather than an identity, because it changes and the user will come back to change it."
  },
  "cycleModeExplanation": "This decides whether estimates make sense. You can change it whenever things change.",
  "@cycleModeExplanation": {
    "description": "Explains why the app asks for a cycle mode at all."
  },
  "modeNatural": "A natural cycle",
  "@modeNatural": {
    "description": "The default mode."
  },
  "modeNaturalDetail": "Estimates are based on the dates you record",
  "@modeNaturalDetail": {
    "description": "What the natural mode does. Never states an estimate as certainty."
  },
  "modeContraception": "Hormonal contraception",
  "@modeContraception": {
    "description": "A mode covering the pill, implant, hormonal coil and similar. Named by what the user is using, never by any effect on her body."
  },
  "modeContraceptionDetail": "No estimates. A withdrawal bleed follows your regimen rather than a cycle, and some regimens bring no bleed at all",
  "@modeContraceptionDetail": {
    "description": "Says what happens and why. Section 10 requires every mode to state why estimates are off rather than silently showing nothing."
  },
  "modePregnancy": "Pregnant",
  "@modePregnancy": {
    "description": "A mode for pregnancy."
  },
  "modePregnancyDetail": "No estimates. Everything you log is still saved",
  "@modePregnancyDetail": {
    "description": "Reassures that logging continues to work, because symptom logging matters more here rather than less."
  },
  "modePerimenopause": "Perimenopause",
  "@modePerimenopause": {
    "description": "A mode for the menopausal transition."
  },
  "modePerimenopauseDetail": "No estimates unless you ask for them. Cycle lengths often change a lot, so an estimate can be misleading",
  "@modePerimenopauseDetail": {
    "description": "The one mode where the user may turn estimates back on. Explains why they are off by default without naming a condition or making a finding."
  },
  "showEstimatesAnyway": "Show estimates anyway",
  "@showEstimatesAnyway": {
    "description": "Switch offered only under perimenopause, the one mode that honours it."
  },
  "showEstimatesAnywayDetail": "Shown as wide ranges, so the spread is visible rather than smoothed away",
  "@showEstimatesAnywayDetail": {
    "description": "Sets the expectation before the user opts in, per section 8: a prediction is never a certainty."
  },
  "showFertileWindow": "Show the fertile window estimate",
  "@showFertileWindow": {
    "description": "Switch turning on the fertile window section of the Today screen. Off unless asked for."
  },
  "yourDataHeading": "Your data",
  "@yourDataHeading": {
    "description": "Heading above the data management section of settings."
  },
  "dataStaysHere": "Everything you log stays on this device, encrypted. Nothing is sent anywhere, and there is no account.",
  "@dataStaysHere": {
    "description": "States the app's central promise where the user can see it. Present tense and factual, not a marketing claim."
  },
  "deleteAllData": "Delete all data",
  "@deleteAllData": {
    "description": "Opens the confirmation for erasing everything."
  },
  "deleteAllDataConfirmTitle": "Delete everything?",
  "@deleteAllDataConfirmTitle": {
    "description": "Title of the confirmation dialogue."
  },
  "deleteAllDataConfirmBody": "Every date, entry, symptom and setting will be erased, and the app will start over as if newly installed. This cannot be undone: there is no backup anywhere.",
  "@deleteAllDataConfirmBody": {
    "description": "Names exactly what goes, including the settings, and that the cycle mode resets with them. Says plainly that there is no recovery, because there is none."
  },
  "deleteEverything": "Delete everything",
  "@deleteEverything": {
    "description": "The confirming button in the delete dialogue. Repeats the action rather than saying OK, so a mistap on an unread dialogue is less likely."
  },
  "everythingDeleted": "Everything deleted",
  "@everythingDeleted": {
    "description": "Confirmation shown after the data is erased."
  }

}
